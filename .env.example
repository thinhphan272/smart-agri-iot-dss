# ==============================================================================
# HỆ THỐNG GIÁM SÁT NÔNG NGHIỆP THÔNG MINH AGRIGUARD-IOT - CẤU HÌNH MÔI TRƯỜNG
# ==============================================================================

# 1. Cơ sở dữ liệu:
# - Mặc định kết nối PostgreSQL.
# - NẾU MÁY BẠN CHƯA CÀI POSTGRESQL: Hệ thống sẽ TỰ ĐỘNG chuyển sang SQLite nội bộ (agri_iot.db)
#   để chạy được ngay 100% mà không cần cài đặt thêm bất kỳ phần mềm database nào!
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agri_iot_db
# Hoặc ép sử dụng SQLite trực tiếp:
# DATABASE_URL=sqlite:///./agri_iot.db

# 2. Cấu hình bảo mật JWT Token
SECRET_KEY=agri_guard_iot_super_secret_jwt_key_2026_dss
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Đường dẫn trọng số mô hình AI (Hệ thống đã tự động định vị sẵn trong thư mục outputs/)
MODEL_PATH=outputs/best_proposed_model.pkl
SCALER_PATH=outputs/preprocessor_scaler.pkl

# 4. Google Gemini API Key (Tùy chọn: Dùng cho Trợ lý AI Bác sĩ Nông học AgriBot trực tuyến)
# Bạn có thể để trống và nhập trực tiếp trên giao diện Web khi cần.
GEMINI_API_KEY=
